    requires=["elementis_zeta"],
    sources=[
        "plugin_stub.c"
    ],  # the plugin's code is the unity build in lib/ending/ (below)
    fap_private_libs=[
        Lib(
            name="ending",
            sources=["ending_unity.c"],
            cflags=SHORT_CALLS_PLUGIN + SMALL7 + PLUGIN_ENDING + ["-fwhole-program"],
            cincludes=["."],
