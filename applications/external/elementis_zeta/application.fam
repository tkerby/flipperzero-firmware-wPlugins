# ---- RELEASE vs DEV build (contract 0 and 5.x) -----------------------------------------------------------------------------------
# `ufbt build` / `ufbt launch` is the RELEASE build (what the player runs): no debug overlay, no debug combos (-1.5 KB resident).
# `NUCLEO_DEBUG=1 ufbt build` / `NUCLEO_DEBUG=1 ufbt launch` is the DEV build (adds -DNUCLEO_DEBUG: Left + Right + OK debug overlay, Up / Down combos, heap
# label on the title list). The variable is read here ONCE and the same list goes to the app and to all 4 plugins, so they always agree.
# After switching mode remove the old objects:  rm -rf ~/.ufbt/build/elementis_zeta* ~/.ufbt/build/ez_*   (tools/mem_budget.sh does that itself). "0" or empty = release.
# (The manifest is exec'd inside ufbt's appmanifest.py, where `os` is available; keep to plain statements and for loops, no comprehensions on these names.)
import os

NUCLEO_DEFINES = ["NUCLEO_DEVICE"]
if os.environ.get("NUCLEO_DEBUG", "") not in ("", "0"):
    NUCLEO_DEFINES = ["NUCLEO_DEBUG", "NUCLEO_DEVICE"]

# ---- Short calls (contract MEM3, "calls") --------------------------------------------------------------------------------------
# ufbt compiles a FAP with -mlong-calls: every call is `ldr rX, =f; blx rX` + a literal word + a load-time relocation. Only the calls to the
# firmware need that. App() has no cflags, so the app's and the plugins' own sources are compiled as private libraries (like the battle
# plugin's unity build below) whose cflags force-include short_calls.h: it declares the firmware / libc API first and then switches to short
# calls, so a call to one of OUR functions is a plain `bl`. The menu, UI and PC plugins also get -fno-function-sections (a static function of
# the same file is then in the same section: its call needs no relocation at all); the resident app keeps function sections (gc-sections
# drops its dead code, +0.6 KB without). A source file that is in none of the lists below (and not excluded from the app's sources) is still
# built into the app, with long calls (correct, just bigger).
# THE RULE FOR A NEW SOURCE FILE: add it to the list of its module: CORE_SRC (resident app); a plugin's file is #included by lib/<plugin>/<plugin>_unity.c instead (battle, menu, ui, pc, casino: one translation unit each, contract 44). Never include a libc / SDK header that short_calls.h does not list.
# `python3 tools/check_short_calls.py` (after a build) proves that no module branches directly to a symbol it does not define.
# Post-M5 memory reserve (contract 27): size-for-speed compiler sub-flags, measured on the linked ELFs (each is a GCC -O2 pass that -Os still runs):
#   SMALL1 = -fno-tree-tail-merge: merging the identical tails of two branches saves bytes and adds a jump to one of them, so not merging is never slower. The only flag
#            the per-pixel code (blit, render, frame compose, the battle plugin's painters) gets.
#   SMALL2 = SMALL1 + -fno-schedule-insns2: the late scheduler only hides load-use stalls (the Cortex-M4 is single-issue, in order); kept off the per-pixel loops, on for the
#            code that runs per step / per turn / per text line (world, map, bank, text, battle core).
#   SMALL7 = SMALL2 + -fno-if-typecast -fno-optimize-sibling-calls -fno-thread-jumps -fno-tree-dominator-opts -fno-code-hoisting: a branch instead of an IT block, a call +
#            return instead of a tail jump ...: only for the boot / glue / file code and the UI plugins, which no frame depends on.
# The default (no sub-flags) is kept for every file that is in none of the lists below, so a new source file is as fast as before until someone measures it.
SMALL1 = ["-fno-tree-tail-merge"]
SMALL2 = SMALL1 + ["-fno-schedule-insns2"]
SMALL7 = SMALL2 + [
    "-fno-if-conversion",
    "-fno-optimize-sibling-calls",
    "-fno-thread-jumps",
    "-fno-tree-dominator-opts",
    "-fno-code-hoisting",
]
# Contract 44: each plugin is one translation unit now (lib/<plugin>/<plugin>_unity.c), so a flag set is measured on the whole unit (a greedy sweep of every GCC -fno-* size flag over the
# unit, SMALL7 already applied; the sums are in the contract). They are the same kind of flag as SMALL7 (a pass that -Os still runs and that only trades a few bytes for a little speed);
# none of these plugins has a frame-rate loop of its own (the battle plugin's painters keep the plain flags, 38.4).
PLUGIN_UI = [
    "-fno-tree-loop-im",
    "-fno-move-loop-invariants",
    "-fno-tree-loop-distribute-patterns",
    "-fno-inline-small-functions",
]
PLUGIN_PC = [
    "-fno-move-loop-invariants",
    "-fno-move-loop-stores",
    "-fno-tree-reassoc",
    "-fno-early-inlining",
    "-fno-auto-inc-dec",
    "-fno-ipa-pure-const",
    "-fno-inline-small-functions",
    "-fno-ira-hoist-pressure",
]
PLUGIN_MENU = [
    "-fno-tree-forwprop",
    "-fno-move-loop-invariants",
    "-fno-guess-branch-probability",
    "-fno-ira-hoist-pressure",
    "-fno-ipa-vrp",
    "-fno-tree-dce",
    "-fno-tree-loop-im",
]
PLUGIN_CASINO = [
    "-fno-move-loop-invariants",
    "-fno-tree-ter",
    "-fno-caller-saves",
    "-fno-ira-hoist-pressure",
    "-fno-tree-loop-ivcanon",
]
PLUGIN_LINK = [
    "-fno-inline-functions-called-once",
    "-fno-tree-loop-distribute-patterns",
    "-fno-move-loop-invariants",
    "-fno-tree-loop-ivcanon",
    "-fno-tree-pre",
    "-fno-ssa-phiopt",
    "-fno-tree-dce",
]  # contract 45.10 / tools/flag_sweep.py: 11,070 -> 10,782 on the object; no per-pixel loop in the unit (the link scene draws text and a few bars)
PLUGIN_ENDING = [
    "-fno-move-loop-invariants",
    "-fno-caller-saves",
    "-fno-guess-branch-probability",
    "-fno-ipa-modref",
    "-fno-tree-copy-prop",
    "-fno-ssa-phiopt",
    "-fno-tree-scev-cprop",
]  # contract 50 / tools/flag_sweep.py over the unit (greedy, SMALL7 on): 5,906 -> 5,790 on the object; the unit has no per-pixel loop of its own (the credits blit a picture per frame through blit_masked, the text goes through the resident font code)
# Contract 83: per-group extras for the resident libraries, found by a per-file sweep of every -fno-<pass> (the sums over the group's files; the plugins keep SMALL7 as it was): core2 (world / map / bank / text / battle core) -fno-shrink-wrap -fno-tree-loop-im -fno-ipa-pure-const (-126 B), core7 -fno-shrink-wrap -fno-tree-coalesce-vars (-36 B). Never on the per-pixel libraries (core1).
CORE2_X = ["-fno-shrink-wrap", "-fno-tree-loop-im", "-fno-ipa-pure-const"]
CORE7_X = ["-fno-shrink-wrap", "-fno-tree-coalesce-vars"]
SHORT_CALLS = ["-include", "short_calls.h"]
SHORT_CALLS_PLUGIN = ["-fno-function-sections", "-include", "short_calls.h"]
CORE_SRC = [
    "assets.c",
    "bag.c",
    "bank.c",
    "battle_core.c",
    "battle_open.c",
    "blit.c",
    "daycare.c",
    "debug.c",
    "font.c",
    "frame.c",
    "game_loop.c",
    "input.c",
    "main.c",
    "map.c",
    "menu_open.c",
    "monpic.c",
    "natives_shop.c",
    "natives.c",
    "party.c",
    "plugin_loader.c",
    "render.c",
    "save.c",
    "scene_choice.c",
    "scene_dialog.c",
    "scene_fade.c",
    "scene_menu.c",
    "scene_world.c",
    "scene.c",
    "script.c",
    "settings.c",
    "sound.c",
    "text.c",
    "ui_open.c",
    "world.c",
]
# Which resident files get which size flags (everything else in CORE_SRC keeps the default flags). CORE_SMALL1: the per-pixel files; CORE_SMALL2: world / map / bank / text /
# battle core; CORE_SMALL7: the boot, scene-glue, natives, loader and file code, never on a per-frame path.
CORE_SMALL1 = ["blit.c", "frame.c", "render.c"]
CORE_SMALL2 = ["bank.c", "battle_core.c", "map.c", "text.c", "world.c"]
CORE_SMALL7 = [
    "assets.c",
    "bag.c",
    "battle_open.c",
    "daycare.c",
    "debug.c",
    "game_loop.c",
    "input.c",
    "main.c",
    "menu_open.c",
    "natives_shop.c",
    "natives.c",
    "party.c",
    "plugin_loader.c",
    "save.c",
    "scene_choice.c",
    "scene_dialog.c",
    "scene_fade.c",
    "scene_menu.c",
    "scene.c",
    "script.c",
    "settings.c",
    "sound.c",
    "ui_open.c",
]
CORE_PLAIN = (
    []
)  # (a loop, not a comprehension: the manifest is exec'd with separate globals / locals, so a comprehension's `if` cannot see these names)
for f in CORE_SRC:
    if f not in CORE_SMALL1 and f not in CORE_SMALL2 and f not in CORE_SMALL7:
        CORE_PLAIN.append(f)
# (the plugins' files are #included by lib/<plugin>/<plugin>_unity.c, contract 44: a new source file of a plugin goes THERE, like the battle plugin's)

App(
    appid="elementis_zeta",
    name="Elementis Zeta",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="nucleo_app",
    stack_size=3 * 1024,  # = MAIN_STACK in config.h (the flip loop thread; measured on the overlay as T)
    fap_icon="icon.png",  # 10x10, 1 bit: the Flipper Apps Catalog bundler requires it
    targets=["f7"],
    fap_file_assets="files",
    cdefines=list(NUCLEO_DEFINES),
    # The battle and the party screen live in the plugins below (loaded only while they are on): keep their files out of
    # the app. plugin_link.c is the host harness' stand-in for plugin_loader.c. The UI screens (title, language picker, name picker,
    # options, Elementi popup, save screen) are in the third plugin below.
    sources=[
        "*.c*",
        "!scene_battle.c",
        "!battle_fx.c",
        "!battle_gfx.c",
        "!battle_run.c",
        "!battle_ai.c",  # contract 82: #included by battle_run.c
        "!blit_fx.c",
        "!battle_plugin.c",
        "!hud_gfx.c",
        "!scene_party.c",
        "!scene_bag.c",
        "!scene_shop.c",
        "!scene_box.c",
        "!scene_card.c",
        "!scene_reg.c",
        "!box.c",
        "!menu_plugin.c",
        "!plugin_link.c",
        "!plugin_stub.c",
        "!scene_title.c",
        "!scene_lang.c",
        "!scene_name.c",
        "!scene_kb.c",
        "!names.c",
        "!save_io.c",
        "!scene_options.c",
        "!scene_mon.c",
        "!scene_save.c",
        "!scene_evo.c",
        "!scene_follow.c",
        "!scene_poison.c",
        "!scene_roam.c",
        "!scene_f2.c",
        "!scene_tcard.c",
        "!battle_load.c",
        "!ui_scene.c",
        "!daycare_pc.c",
        "!ui_plugin.c",
        "!casino.c",
        "!scene_slots.c",
        "!scene_prize.c",
        "!casino_plugin.c",
        "!link_phy.c",
        "!link_proto.c",
        "!link_game.c",
        "!scene_link.c",
        "!link_ir.c",
        "!link_plugin.c",
        "!hof.c",
        "!scene_ending.c",
        "!ending_plugin.c",
    ]
    + [
        "!" + f for f in CORE_SRC
    ],  # the app's own code is the private libraries "core", "core1", "core2" and "core7" below; what is left here is the C++ API table
    fap_private_libs=[
        Lib(
            name="core",
            sources=["../../" + f for f in CORE_PLAIN],
            cflags=SHORT_CALLS,
            cincludes=["."],
        ),
        Lib(
            name="core1",
            sources=["../../" + f for f in CORE_SMALL1],
            cflags=SHORT_CALLS + SMALL1,
            cincludes=["."],
        ),
        Lib(
            name="core2",
            sources=["../../" + f for f in CORE_SMALL2],
            cflags=SHORT_CALLS + SMALL2 + CORE2_X,
            cincludes=["."],
        ),
        Lib(
            name="core7",
            sources=["../../" + f for f in CORE_SMALL7],
            cflags=SHORT_CALLS + SMALL7 + CORE7_X,
            cincludes=["."],
        ),
    ],
    fap_category="Games",
    fap_author="Daniel Jahziel",
    fap_version="1.0",
    fap_weburl="https://github.com/jahziel1/Elementis-Zeta",  # source repository (the CHANGE-ME placeholder is replaced by tools/export_public.sh --repo-url)
    fap_description="Creature-collecting RPG with 4-level grayscale, 4 languages and an IR link",  # = short_description of the catalog manifest
)

# Battle plugin (contract section 10.7): built as ez_battle.fal, embedded in the FAP (fal_embedded) and extracted
# with the app assets to /ext/apps_assets/elementis_zeta/plugins/. Its imports from the app are listed in app_api_table_i.h.
# Since MEM3 its code is ONE translation unit, the private library "battle" (lib/battle/battle_unity.c #includes scene_battle.c, battle_fx.c,
# battle_gfx.c, battle_run.c, blit_fx.c, hud_gfx.c, battle_plugin.c) compiled with -fno-function-sections -fwhole-program: calls inside the plugin are plain
# `bl` instead of `ldr; blx` + literal + relocation (-1.4 KB of code, -1.8 KB of relocation data). A new battle source file is #included there.
App(
    appid="ez_battle",
    apptype=FlipperAppType.PLUGIN,
    entry_point="nucleo_battle_ep",
    requires=["elementis_zeta"],
    sources=[
        "plugin_stub.c"
    ],  # the plugin's code is the unity build in lib/battle/ (below)
    cdefines=list(NUCLEO_DEFINES),
    fap_private_libs=[
        Lib(
            name="battle",
            sources=["battle_unity.c"],
            cflags=["-fno-function-sections", "-fwhole-program"],
            cincludes=["."],
        ),
    ],
    fal_embedded=True,
)

# Menu plugin (contract sections 11, 15 and 17): the party, bag and shop screens, built as ez_menu.fal, loaded when "Equipo" / "Mochila"
# is opened and unloaded when they have closed. Same mechanism and symbol table as the battle plugin; one plugin at a time (plugin_host.h).
App(
    appid="ez_menu",
    apptype=FlipperAppType.PLUGIN,
    entry_point="nucleo_menu_ep",
    requires=["elementis_zeta"],
    sources=[
        "plugin_stub.c"
    ],  # the plugin's code is the unity build in lib/menu/ (below)
    fap_private_libs=[
        Lib(
            name="menu",
            sources=["menu_unity.c"],
            cflags=SHORT_CALLS_PLUGIN + SMALL7 + PLUGIN_MENU + ["-fwhole-program"],
            cincludes=["."],
        ),
    ],
    cdefines=list(NUCLEO_DEFINES),
    fal_embedded=True,
)

# UI plugin (contract section 11.5): the screens that are never on while exploring or fighting (title + Continuar list, first-run
# language picker, name picker + naming keyboard + nickname prompt, options, Elementi picture popup, "Guardar" screen), built as ez_ui.fal and loaded only while
# one of them is on. Same mechanism and symbol table as the other plugins; one plugin at a time (plugin_host.h).
App(
    appid="ez_ui",
    apptype=FlipperAppType.PLUGIN,
    entry_point="nucleo_ui_ep",
    requires=["elementis_zeta"],
    sources=[
        "plugin_stub.c"
    ],  # the plugin's code is the unity build in lib/ui/ (below)
    fap_private_libs=[
        Lib(
            name="ui",
            sources=["ui_unity.c"],
            cflags=SHORT_CALLS_PLUGIN + SMALL7 + PLUGIN_UI + ["-fwhole-program"],
            cincludes=["."],
        ),
    ],
    cdefines=list(NUCLEO_DEFINES),
    fal_embedded=True,
)

# PC plugin (contract sections 25 and 25.6): the PC box screen, the trainer card and the post-battle store scene, built as ez_pc.fal, loaded when one of them opens
# (menu_open_pc / _card / _store, menu_open.c) and unloaded when they have closed. It was part of the menu plugin until M5's memory recovery (the menu plugin was 17 KB,
# the free heap with the party screen open 25.5 KB against a floor of 30 KB). Same mechanism and symbol table as the other plugins; one plugin at a time (plugin_host.h).
App(
    appid="ez_pc",
    apptype=FlipperAppType.PLUGIN,
    entry_point="nucleo_pc_ep",
    requires=["elementis_zeta"],
    sources=[
        "plugin_stub.c"
    ],  # the plugin's code is the unity build in lib/pc/ (below)
    fap_private_libs=[
        Lib(
            name="pc",
            sources=["pc_unity.c"],
            cflags=SHORT_CALLS_PLUGIN + SMALL7 + PLUGIN_PC + ["-fwhole-program"],
            cincludes=["."],
        ),
    ],
    cdefines=list(NUCLEO_DEFINES),
    fal_embedded=True,
)

# Casino plugin (contract section 37): the casino's slot machine, the prize counter priced in coins and the coin purchase, built as ez_casino.fal, loaded by the script native `pc`
# with a casino operation (natives_shop.c) and unloaded when the scenes have closed. A fifth plugin: the PC plugin had 2.5 KB of heap headroom in the DEV build and the casino is ~5 KB.
# Same mechanism and symbol table as the other plugins; one plugin at a time (plugin_host.h).
App(
    appid="ez_casino",
    apptype=FlipperAppType.PLUGIN,
    entry_point="nucleo_casino_ep",
    requires=["elementis_zeta"],
    sources=[
        "plugin_stub.c"
    ],  # the plugin's code is the unity build in lib/casino/ (below)
    fap_private_libs=[
        Lib(
            name="casino",
            sources=["casino_unity.c"],
            cflags=SHORT_CALLS_PLUGIN + SMALL7 + PLUGIN_CASINO + ["-fwhole-program"],
            cincludes=["."],
        ),
    ],
    cdefines=list(NUCLEO_DEFINES),
    fal_embedded=True,
)

# Link plugin (contract section 45): the Club de Enlace, trade and exhibition battle over the infrared port, built as ez_link.fal, loaded by the script native `pc` with a link operation (ops 9..12 of native 22,
# natives_shop.c) and unloaded when its scene has closed. ONE translation unit like every plugin (contract 44): lib/link/link_unity.c #includes link_phy.c, link_proto.c, link_game.c,
# hud_gfx.c, scene_link.c, link_ir.c and link_plugin.c. Same mechanism and symbol table as the other plugins; one plugin at a time (plugin_host.h).
App(
    appid="ez_link",
    apptype=FlipperAppType.PLUGIN,
    entry_point="nucleo_link_ep",
    requires=["elementis_zeta"],
    sources=[
        "plugin_stub.c"
    ],  # the plugin's code is the unity build in lib/link/ (below)
    fap_private_libs=[
        Lib(
            name="link",
            sources=["link_unity.c"],
            cflags=SHORT_CALLS_PLUGIN + SMALL7 + PLUGIN_LINK + ["-fwhole-program"],
            cincludes=["."],
        ),
    ],
    cdefines=list(NUCLEO_DEFINES),
    fal_embedded=True,
)

# Ending plugin (contract section 50): the Hall of Legacy scenes, its PC browser, the credits and FIN, built as ez_ending.fal, loaded by the script native `pc` with the operation 14 (natives_shop.c) and unloaded when its
# scene has closed. ONE translation unit like every plugin (contract 44): lib/ending/ending_unity.c #includes hof.c, box.c (box_name only), plugin_fs.c (write_file), hud_gfx.c and scene_ending.c / ending_plugin.c.
# Same mechanism and symbol table as the other plugins; one plugin at a time (plugin_host.h).
App(
