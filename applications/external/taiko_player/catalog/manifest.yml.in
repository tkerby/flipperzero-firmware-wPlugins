# Generate manifest.yml after committing and pushing the source repository.
# Name, app ID, category, version, author, and icon are inherited from application.fam.
sourcecode:
  type: git
  location:
    origin: https://github.com/ZeroNinx/flipper-zero-taiko-player.git
    commit_sha: "@SOURCE_COMMIT@"
description: "@docs/catalog-description.md"
changelog: "@docs/changelog.md"
screenshots:
  - screenshots/playing.png
