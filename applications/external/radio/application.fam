    fap_category="GPIO",
    fap_author="victormico",
    fap_weburl="https://github.com/victormico/flipperzero-radio",
    fap_version="0.1",
    fap_description="TEA5767/Si4703 FM radio with Si4703 volume, RDS station names and radio text",
)
