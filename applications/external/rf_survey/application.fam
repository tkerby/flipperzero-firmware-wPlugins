App(
    appid="rfsurvey",
    name="RF Survey",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="rf_survey_app",
    stack_size=4 * 1024,
    fap_icon="rfsurvey.png",
    fap_category="Sub-GHz",
    fap_author="tbelbek",
    fap_weburl="https://github.com/tbelbek/flipper-rf-survey",
    fap_version="1.1",
    fap_description="Sweep a frequency range, log RSSI over time to CSV, locate a source and capture it to .sub. Sub-GHz only, RX.",
)
