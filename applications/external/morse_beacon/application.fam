App(
    appid="morse_beacon",
    name="Morse Beacon",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="morse_beacon_app",
    stack_size=2 * 1024,
    fap_icon="morse_beacon.png",
    fap_icon_assets="images",
    sources=[
        "beacon.c",
        "config.c",
        "idlog.c",
        "link.c",
        "morse.c",
        "morse_beacon.c",
        "radio.c",
    ],
    fap_category="Sub-GHz",
    fap_author="jdmills",
    fap_weburl="https://github.com/jdmills-edu/flipper-morse-beacon",
    fap_version="1.0",
    fap_description="Sub-GHz Morse station ID and text beacon",
)
