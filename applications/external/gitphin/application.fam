App(
    appid="gitphin",
    name="Gitphin",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="gitphin_app",
    stack_size=2 * 1024,
    fap_icon="gitphin_10.png",
    fap_file_assets="files",
    targets=["f7"],
    # The resident core. Everything else is a plugin (.fal) that the core loads
    # on demand, one at a time (hub_plugin.c). The plugins are embedded in the
    # .fap (fal_embedded) and unpacked to apps_assets/gitphin/plugins/ on start,
    # so the single .fap is the whole app.
    sources=[
        "gitphin.c",
        "hub_http.c",
        "hub_chunk.c",
        "hub_transport.c",
        "hub_mem.c",
        "hub_plugin.c",
        "hub_git.c",
        "hub_gitview.c",
        "hub_gitobj.c",
        "hub_gitio_furi.c",
        "hub_inflate.c",
    ],
    fap_category="USB",
    fap_author="Kazuki Kimura (Adhamura)",
    fap_weburl="https://github.com/Adhamura/Gitphin",
    fap_version="1.1",
    fap_description="Git hosting in your pocket: a Git server and web UI for your repos, used from the PC over USB",
)

App(
    appid="hub_pl_dav",
    apptype=FlipperAppType.PLUGIN,
    entry_point="hub_pl_dav_ep",
    requires=["gitphin"],
    fal_embedded=True,
    sources=["hub_dav.c"],
)

App(
    appid="hub_pl_pack",
    apptype=FlipperAppType.PLUGIN,
    entry_point="hub_pl_pack_ep",
    requires=["gitphin"],
    fal_embedded=True,
    sources=[
        "hub_plugin_pack.c",
        "hub_gitpack.c",
        "hub_gitgraph.c",
        "hub_deflate.c",
        "hub_sha1.c",
        "hub_gitdocutil.c",
    ],
)

App(
    appid="hub_pl_write",
    apptype=FlipperAppType.PLUGIN,
    entry_point="hub_pl_write_ep",
    requires=["gitphin"],
    fal_embedded=True,
    cdefines=["HUB_EXT_WRITE"],
    sources=[
        "hub_gitext.c",
        "hub_gitcommit.c",
        "hub_gitwrite.c",
        "hub_gitwrite_furi.c",
        "hub_gitdiff.c",
        "hub_sha1.c",
    ],
)

App(
    appid="hub_pl_query",
    apptype=FlipperAppType.PLUGIN,
    entry_point="hub_pl_query_ep",
    requires=["gitphin"],
    fal_embedded=True,
    cdefines=["HUB_EXT_QUERY"],
    sources=["hub_gitext.c", "hub_gitdiff.c", "hub_gitsearch.c"],
)

App(
    appid="hub_pl_doc",
    apptype=FlipperAppType.PLUGIN,
    entry_point="hub_pl_doc_ep",
    requires=["gitphin"],
    fal_embedded=True,
    sources=["hub_gitdoc.c", "hub_gitdocutil.c"],
)
