App(
    appid="rfid_maker",
    name="RFID Maker",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="rfid_maker_app",
    sources=["card_formats.c", "decimal_input.c", "rfid_maker.c"],
    stack_size=4 * 1024,
    fap_icon="icon.png",
    fap_category="RFID",
    fap_author="KindaCharming / jeremydbean",
    fap_weburl="https://github.com/jeremydbean/FlipperRFIDMaker",
    fap_version="0.9",
    fap_description="Create RFID files from decimal facility codes and card numbers",
)
