#!/usr/bin/env python3
"""Gitphin: Git remote helper (git-remote-flipper) and CLI (git flipper).

Usage: git remote add origin flipper://<name>     then git push / fetch / clone as usual
       git flipper list
       git flipper create <name> [-d text] [-b branch]
       git flipper delete <name> --yes
       git flipper rename <old> <new>
       git flipper describe <name> <text>
       git flipper url <name>
       git flipper gc <name>
Env:   GITPHIN_URL      server base URL (default http://127.0.0.1:8080; FLIPPER_HUB_URL also works)

One script, two names (install.sh makes the links). The name it runs under
picks the mode: git-remote-flipper speaks the remote helper protocol on
stdin/stdout (see `man gitremote-helpers`), git-flipper is the CLI.
Only stdlib Python and the system `git`. Logs go to stderr, never stdout.
"""

import http.client
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import quote, urlencode, urlsplit

ZERO = "0" * 40
DEFAULT_URL = "http://127.0.0.1:8080"
API_TIMEOUT_S = 120.0  # metadata calls; transfers have no timeout (about 120 KB/s)
NAME_RE = re.compile(r"^[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
PACK_RE = re.compile(r"^pack-[0-9a-f]{40,64}\.pack$")
REF_BAD_CHARS = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]")


def log(msg):
    print(f"[flipper-git] {msg}", file=sys.stderr, flush=True)


class HubError(Exception):
    def __init__(self, msg, status=0):
        super().__init__(msg)
        self.status = status


# ---------------------------------------------------------------- names

def valid_name(name):
    return bool(NAME_RE.match(name)) and not name.endswith(".git")


def check_name(name):
    if not valid_name(name):
        raise HubError(f"bad repo name: {name!r}")
    return name


def valid_ref(ref):
    """Full ref name under refs/heads or refs/tags, rules from docs/git-design.md."""
    if not (ref.startswith("refs/heads/") or ref.startswith("refs/tags/")):
        return False
    if REF_BAD_CHARS.search(ref) or ".." in ref or "//" in ref or "@{" in ref:
        return False
    if ref.endswith("/") or ref.endswith(".") or ref.endswith(".lock"):
        return False
    for part in ref.split("/"):
        if part.startswith(".") or part.endswith(".lock") or not part:
            return False
    return True


def repo_path(name, rest=""):
    return f"/ext/git/{name}.git" + (f"/{rest}" if rest else "")


# ---------------------------------------------------------------- http

class Hub:
    """Plain HTTP client for the Flipper server (or the mock)."""

    def __init__(self, base=None):
        base = base or os.environ.get("GITPHIN_URL") or os.environ.get("FLIPPER_HUB_URL") or DEFAULT_URL
        parts = urlsplit(base if "//" in base else "http://" + base)
        self.host = parts.hostname or "127.0.0.1"
        self.port = parts.port or 80
        self.base = f"http://{self.host}:{self.port}"
        self.progress = True

    def _open(self, method, path, query=None, body=None, headers=None, timeout=API_TIMEOUT_S):
        if query:
            q = {k: v for k, v in query.items() if v is not None}
            path += "?" + urlencode(q, quote_via=quote, safe="/")
        conn = http.client.HTTPConnection(self.host, self.port, timeout=timeout)
        try:
            conn.request(method, path, body=body, headers=headers or {})
            return conn, conn.getresponse()
        except OSError as e:
            conn.close()
            raise HubError(f"cannot reach {self.base}: {e}") from e

    def api(self, method, route, **query):
        """JSON call. Returns the decoded dict; raises HubError on ok:false or 4xx/5xx."""
        conn, resp = self._open(method, route, query)
        try:
            return self._json(resp)
        finally:
            conn.close()

    @staticmethod
    def _json(resp):
        raw = resp.read()
        try:
            data = json.loads(raw.decode("utf-8", "replace"))
        except ValueError:
            data = {}
        if resp.status >= 400 or not data.get("ok", False):
            msg = data.get("error") or f"HTTP {resp.status}"
            raise HubError(msg, resp.status)
        return data

    def download(self, path, dest, label):
        conn, resp = self._open("GET", path, timeout=None)
        try:
            if resp.status != 200:
                resp.read()
                raise HubError(f"GET {path}: HTTP {resp.status}", resp.status)
            total = int(resp.getheader("Content-Length") or 0)
            meter = Meter(label, total, self.progress)
            with open(dest, "wb") as f:
                while True:
                    chunk = resp.read(65536)
                    if not chunk:
                        break
                    f.write(chunk)
                    meter.add(len(chunk))
            meter.done()
        finally:
            conn.close()

    def upload(self, remote_path, local_path, label):
        size = os.path.getsize(local_path)
        meter = Meter(label, size, self.progress)
        with open(local_path, "rb") as f:
            body = MeteredFile(f, meter)
            headers = {"Content-Length": str(size), "Content-Type": "application/octet-stream"}
            conn, resp = self._open("PUT", "/api/file", {"path": remote_path}, body, headers, None)
            try:
                self._json(resp)
            finally:
                conn.close()
        meter.done()

    # -- typed calls
    def refs(self, name):
        """Remote refs dict {ref: sha} and HEAD ref, or None when the repo is missing."""
        try:
            d = self.api("GET", "/api/git/refs", name=name)
        except HubError as e:
            if e.status == 404:
                return None
            raise
        return {r["name"]: r["sha"] for r in d.get("refs", [])}, d.get("head") or ""

    def packs(self, name):
        """Names of every file in the remote objects/pack folder (empty when missing)."""
        try:
            d = self.api("GET", "/api/list", path=repo_path(name, "objects/pack"))
        except HubError as e:
            if e.status == 404:
                return []
            raise
        return sorted(e["name"] for e in d.get("entries", []) if not e.get("dir"))

    def server_info(self, name):
        self.api("POST", "/api/git/server-info", name=name)

    def delete_file(self, name, rest):
        self.api("POST", "/api/delete", path=repo_path(name, rest))


class Meter:
    """Transfer progress on stderr. One line on a pipe, a live percentage on a tty."""

    def __init__(self, label, total, enabled):
        self.label, self.total, self.seen = label, total, 0
        self.enabled = enabled
        self.live = enabled and sys.stderr.isatty()
        if enabled and not self.live:
            log(f"{label} ({total // 1024} KB)")

    def add(self, n):
        self.seen += n
        if self.live and self.total:
            print(f"\r[flipper-git] {self.label} {100 * self.seen // self.total}%",
                  end="", file=sys.stderr, flush=True)

    def done(self):
        if self.live:
            print(f"\r[flipper-git] {self.label} done ({self.seen // 1024} KB)    ",
                  file=sys.stderr, flush=True)


class MeteredFile:
    """File wrapper for http.client: counts the bytes it hands out."""

    def __init__(self, f, meter):
        self.f, self.meter = f, meter

    def read(self, n=-1):
        data = self.f.read(n)
        self.meter.add(len(data))
        return data


# ---------------------------------------------------------------- git

def git(args, git_dir=None, input_text=None, check=True):
    """Run git with stdout captured (stdout belongs to the protocol). Returns the process."""
    env = dict(os.environ)
    if git_dir:
        env["GIT_DIR"] = git_dir
    proc = subprocess.run(
        ["git"] + args, env=env, stdout=subprocess.PIPE, stderr=None if check else subprocess.DEVNULL,
        input=input_text.encode() if input_text is not None else None,
        stdin=None if input_text is not None else subprocess.DEVNULL)
    if check and proc.returncode != 0:
        raise HubError(f"git {' '.join(args[:2])} failed ({proc.returncode})")
    return proc


def git_out(args, **kw):
    return git(args, **kw).stdout.decode().strip()


def local_objects(shas):
    """Subset of shas whose objects exist in the local repository."""
    if not shas:
        return set()
    out = git_out(["cat-file", "--batch-check"], input_text="\n".join(shas) + "\n")
    return {line.split()[0] for line in out.splitlines() if not line.endswith("missing")}


def pack_dir(git_dir=None):
    p = git_out(["rev-parse", "--git-path", "objects/pack"], git_dir=git_dir)
    return os.path.abspath(p)


def fetch_packs(hub, name, dest_dir, git_dir=None):
    """Download remote packs missing in dest_dir and index them locally. Returns the new count."""
    os.makedirs(dest_dir, exist_ok=True)
    fetched = 0
    for fname in hub.packs(name):
        if not PACK_RE.match(fname):
            continue
        stem = fname[:-5]
        if os.path.exists(os.path.join(dest_dir, stem + ".idx")):
            continue
        tmp = os.path.join(dest_dir, f"tmp_flipper_{os.getpid()}")
        try:
            hub.download(f"/git/{name}.git/objects/pack/{fname}", tmp + ".pack", f"fetch {stem[:15]}")
            git(["index-pack", "-o", tmp + ".idx", tmp + ".pack"], git_dir=git_dir)
            os.replace(tmp + ".pack", os.path.join(dest_dir, fname))
            os.replace(tmp + ".idx", os.path.join(dest_dir, stem + ".idx"))
        finally:
            for ext in (".pack", ".idx"):
                if os.path.exists(tmp + ext):
                    os.unlink(tmp + ext)
        fetched += 1
    return fetched


def build_pack(tips, excludes, outdir):
    """One `pack-objects --revs`. Returns the pack hash, or None when the pack is empty."""
    lines = list(tips) + ["^" + s for s in excludes]
    args = ["pack-objects", "--revs", "--delta-base-offset"]
    if not sys.stderr.isatty():
        args.append("-q")
    out = git_out(args + [os.path.join(outdir, "pack")], input_text="\n".join(lines) + "\n")
    if not out:
        return None
    h = out.splitlines()[-1]
    with open(os.path.join(outdir, f"pack-{h}.pack"), "rb") as f:
        header = f.read(12)  # "PACK", version, object count (big endian)
    return h if int.from_bytes(header[8:12], "big") else None


def upload_pack(hub, name, outdir, h):
    stem = f"pack-{h}"
    for ext in (".pack", ".idx"):  # pack first: an idx without its pack is the bad state
        hub.upload(repo_path(name, f"objects/pack/{stem}{ext}"), os.path.join(outdir, stem + ext),
                   f"push {stem[:15]}{ext}")


# ---------------------------------------------------------------- remote helper

class Helper:
    def __init__(self, name):
        self.name = name
        self.hub = Hub()
        self.refs = None   # {ref: sha} as read by `list`; None until read
        self.head = ""
        self.exists = False

    def load_refs(self):
        got = self.hub.refs(self.name)
        self.exists = got is not None
        self.refs, self.head = got if got else ({}, "")

    # -- commands
    def cmd_list(self, out):
        self.load_refs()
        for ref in sorted(self.refs):
            out(f"{self.refs[ref]} {ref}")
        if self.head in self.refs:
            out(f"@{self.head} HEAD")
        out("")

    def cmd_fetch(self, out):
        n = fetch_packs(self.hub, self.name, pack_dir())
        if n:
            log(f"fetched {n} pack(s)")
        out("")

    def cmd_push(self, specs, out):
        if self.refs is None:
            self.load_refs()
        results = self.push(specs)
        for dst, err in results:
            out(f"ok {dst}" if err is None else f"error {dst} {err}")
        out("")

    # -- push logic
    def plan_one(self, force, src, dst):
        """Returns (new_sha, None) or (None, error text) for one refspec."""
        if not valid_ref(dst):
            return None, "invalid ref name"
        old = self.refs.get(dst, ZERO)
        if not src:
            return (ZERO, None) if old != ZERO else (None, "remote ref does not exist")
        try:
            new = git_out(["rev-parse", "--verify", "-q", src])
        except HubError:
            new = ""
        if not SHA_RE.match(new):
            return None, "src refspec does not match any"
        if old == ZERO or old == new or force:
            return new, None
        if dst.startswith("refs/tags/"):
            return None, "already exists"
        if old not in local_objects([old]):
            return None, "fetch first"
        ok = git(["merge-base", "--is-ancestor", old, new], check=False).returncode == 0
        return (new, None) if ok else (None, "non-fast-forward")

    def push(self, specs):
        plan, results = [], {}
        for force, src, dst in specs:
            new, err = self.plan_one(force, src, dst)
            if err:
                results[dst] = err
            else:
                plan.append((dst, new))
        changes = [(d, n) for d, n in plan if n != self.refs.get(d, ZERO)]
        for dst, new in plan:
            results.setdefault(dst, None)
        if changes:
            try:
                uploaded = self.send_objects([n for _, n in changes if n != ZERO])
            except HubError as e:
                for dst, _ in changes:
                    results[dst] = str(e)
                return [(s[2], results[s[2]]) for s in specs]
            for dst, new in changes:
                results[dst] = self.update_ref(dst, new)
            self.finish(changes, results, uploaded)
        return [(s[2], results[s[2]]) for s in specs]

    def send_objects(self, tips):
        """Create the repo if needed, then pack and upload. Returns True when a pack went up."""
        if not self.exists:
            log(f"creating repository {self.name}")
            self.hub.api("POST", "/api/git/create", name=self.name)
            self.exists = True
        if not tips:
            return False
        outdir = tempfile.mkdtemp(prefix="flipper-pack-")
        try:
            excludes = sorted(local_objects(sorted(set(self.refs.values()))))
            h = build_pack(sorted(set(tips)), excludes, outdir)
            if not h:
                return False
            upload_pack(self.hub, self.name, outdir, h)
            return True
        finally:
            shutil.rmtree(outdir, ignore_errors=True)

    def update_ref(self, dst, new):
        old = self.refs.get(dst, ZERO)
        try:
            self.hub.api("POST", "/api/git/ref", name=self.name, ref=dst, old=old, new=new)
        except HubError as e:
            return "stale info" if e.status == 409 else str(e)
        if new == ZERO:
            self.refs.pop(dst, None)
        else:
            self.refs[dst] = new
        return None

    def finish(self, changes, results, uploaded):
        pushed = [d for d, n in changes if n != ZERO and results[d] is None and d.startswith("refs/heads/")]
        if pushed and self.head not in self.refs:
            branch = pushed[0][len("refs/heads/"):]
            try:
                self.hub.api("POST", "/api/git/head", name=self.name, branch=branch)
                self.head = "refs/heads/" + branch
            except HubError as e:
                log(f"cannot set HEAD: {e}")
        if uploaded or any(results[d] is None for d, _ in changes):
            try:
                self.hub.server_info(self.name)
            except HubError as e:
                log(f"server-info failed: {e}")


def read_batch(stdin, first):
    """The command line `first` plus the following lines up to the blank line."""
    batch = [first]
    for line in stdin:
        line = line.rstrip("\n")
        if not line:
            break
        batch.append(line)
    return batch


def parse_push(line):
    spec = line[len("push "):]
    force = spec.startswith("+")
    src, _, dst = spec.lstrip("+").partition(":")
    return force, src, dst


def helper_main(argv):
    if not argv:
        log("usage: git-remote-flipper <remote> [<url>]")
        return 2
    url = argv[-1]
    name = re.sub(r"^flipper:/*", "", url).strip("/")
    name = name[:-4] if name.endswith(".git") else name
    helper = Helper(check_name(name))

    def out(line):
        sys.stdout.write(line + "\n")
        if not line:
            sys.stdout.flush()

    stdin = iter(sys.stdin.readline, "")
    for line in stdin:
        line = line.rstrip("\n")
        if line == "capabilities":
            for cap in ("option", "fetch", "list", "push"):
                out(cap)
            out("")
        elif line.startswith("option "):
            out(handle_option(helper, line))
            sys.stdout.flush()
        elif line.startswith("list"):
            helper.cmd_list(out)
        elif line.startswith("fetch "):
            read_batch(stdin, line)
            helper.cmd_fetch(out)
        elif line.startswith("push "):
            specs = [parse_push(b) for b in read_batch(stdin, line)]
            helper.cmd_push(specs, out)
        elif not line:
            break
        else:
            log(f"unknown command: {line}")
            return 1
    sys.stdout.flush()
    return 0


def handle_option(helper, line):
    parts = line.split()
    if len(parts) == 3 and parts[1] == "progress":
        helper.hub.progress = parts[2] == "true"
        return "ok"
    if len(parts) == 3 and parts[1] == "verbosity":
        return "ok"
    return "unsupported"


# ---------------------------------------------------------------- git flipper CLI

def cmd_list(hub, args):
    repos = hub.api("GET", "/api/git/repos").get("repos", [])
    width = max([len(r["name"]) for r in repos] + [4])
    for r in repos:
        print(f"{r['name']:<{width}}  {r.get('head', ''):<10} {r.get('packs', 0):>3} pack(s)  "
              f"{r.get('description', '')}")


def cmd_create(hub, args):
    opts = {"-d": None, "-b": None}
    names, it = [], iter(args)
    for a in it:
        if a in opts:
            opts[a] = next(it, None)
            if opts[a] is None:
                raise HubError(f"{a} needs a value")
        else:
            names.append(a)
    if len(names) != 1:
        raise HubError("usage: git flipper create <name> [-d text] [-b branch]")
    name = check_name(names[0])
    hub.api("POST", "/api/git/create", name=name, branch=opts["-b"], description=opts["-d"])
    print(f"created {name}")
    print(f"flipper://{name}")


def cmd_delete(hub, args):
    if len(args) != 2 or args[1] != "--yes":
        raise HubError("usage: git flipper delete <name> --yes")
    hub.api("POST", "/api/git/delete", name=check_name(args[0]))
    print(f"deleted {args[0]}")


def cmd_rename(hub, args):
    if len(args) != 2:
        raise HubError("usage: git flipper rename <old> <new>")
    hub.api("POST", "/api/git/rename", name=check_name(args[0]), to=check_name(args[1]))
    print(f"renamed {args[0]} to {args[1]}")


def cmd_describe(hub, args):
    if len(args) < 2:
        raise HubError("usage: git flipper describe <name> <text>")
    hub.api("POST", "/api/git/describe", name=check_name(args[0]), text=" ".join(args[1:]))


def cmd_url(hub, args):
    if len(args) != 1:
        raise HubError("usage: git flipper url <name>")
    name = check_name(args[0])
    print(f"flipper://{name}")
    print(f"{hub.base}/git/{name}.git")


def cmd_gc(hub, args):
    if len(args) != 1:
        raise HubError("usage: git flipper gc <name>")
    name = check_name(args[0])
    got = hub.refs(name)
    if got is None:
        raise HubError(f"no such repository: {name}")
    refs, _ = got
    old = hub.packs(name)
    old_packs = [f for f in old if PACK_RE.match(f)]
    if not old_packs:
        print("nothing to do")
        return
    tmp = tempfile.mkdtemp(prefix="flipper-gc-")
    try:
        repo = os.path.join(tmp, "r.git")
        git(["init", "--bare", "-q", repo])
        fetch_packs(hub, name, os.path.join(repo, "objects", "pack"), git_dir=repo)
        for ref, sha in refs.items():
            git(["update-ref", ref, sha], git_dir=repo)
        git(["repack", "-a", "-d", "-q"], git_dir=repo)
        new = [f for f in os.listdir(os.path.join(repo, "objects", "pack")) if PACK_RE.match(f)]
        if len(new) != 1:
            raise HubError(f"repack made {len(new)} packs, expected 1")
        keep = new[0][:-5]
        if new[0] not in old_packs:
            upload_pack(hub, name, os.path.join(repo, "objects", "pack"), keep[len("pack-"):])
        hub.server_info(name)
        for fname in old:
            if fname.startswith("pack-") and not fname.startswith(keep + "."):
                hub.delete_file(name, f"objects/pack/{fname}")
        hub.server_info(name)
        print(f"gc {name}: {len(old_packs)} pack(s) -> 1")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


COMMANDS = {
    "list": cmd_list, "create": cmd_create, "delete": cmd_delete, "rename": cmd_rename,
    "describe": cmd_describe, "url": cmd_url, "gc": cmd_gc,
}


def cli_main(argv):
    if not argv or argv[0] not in COMMANDS:
        log("usage: git flipper {" + "|".join(COMMANDS) + "} ...")
        return 2
    COMMANDS[argv[0]](Hub(), argv[1:])
    return 0


def main():
    prog = os.path.basename(sys.argv[0])
    try:
        if prog == "git-flipper":
            return cli_main(sys.argv[1:])
        if prog == "git-remote-flipper":
            return helper_main(sys.argv[1:])
        log("run as git-remote-flipper or git-flipper")
        return 2
    except HubError as e:
        log(f"error: {e}")
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
