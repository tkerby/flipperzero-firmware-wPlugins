App(
    appid="portal_putt",
    name="Portal Putt",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="portal_putt_app",
    requires=["gui", "notification", "storage"],
    stack_size=4 * 1024,
    fap_category="Games",
    fap_icon="icon.png",
    fap_author="rseufert",
    fap_weburl="https://github.com/rseufert/portal_putt",
    fap_version="0.1",
    fap_description="Fantasy and sci-fi minigolf: nine holes of portals, gravity wells, lava and dragons",
    sources=["portal_putt.c", "course.c", "sim.c"],
)
