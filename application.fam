App(
    appid="flipper_wifi_radio",
    name="Flipper WiFi Radio",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipper_wifi_radio_app",
    requires=["gui"],
    # ufbt's default source glob is recursive — pin these so a test/ dir with
    # its own main() can never get compiled into the FAP.
    sources=["radio_app.c", "radio_proto.c", "radio_uart.c", "mp3_pacer.c"],
    stack_size=8 * 1024,
    fap_version="1.0",
    fap_description="Stream MP3s from the SD card as a live WiFi radio station anyone nearby can tune into with a browser",
    fap_category="Tools",
    fap_icon="flipper_wifi_radio_10x10.png",
    fap_author="thecoolguy2001",
    fap_weburl="https://github.com/thecoolguy2001/flipper-wifi-radio",
)
