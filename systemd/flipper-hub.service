[Unit]
Description=Flipper Hub bridge (http://localhost:8080 <-> HTTP server on the Flipper)

[Service]
Type=simple
# Add --open-browser to open the page on every plug-in.
ExecStart=%h/Desktop/Flipper/flipper_hub/.venv/bin/python -I %h/Desktop/Flipper/flipper_hub/pc/bridge.py --port 8080
# The bridge exits by itself when the Flipper is unplugged; the path unit starts it again.
Restart=on-failure
RestartSec=5
